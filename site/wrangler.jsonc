{
  "name": "dewline-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dewline.arkwerx.com", "custom_domain": true }],
  "assets": { "directory": ".", "run_worker_first": ["/go/*", "/download"] },
  "analytics_engine_datasets": [{ "binding": "GO", "dataset": "dewline_go" }]
}
